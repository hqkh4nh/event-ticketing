{
  "expo": {
    "name": "Event Ticketing",
    "slug": "event-ticketing",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eventticketing",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.anonymous.eventticketing"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FF6B4A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ],
      "package": "com.anonymous.eventticketing"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F4",
          "image": "./assets/images/splash-icon.png",
          "dark": {
            "backgroundColor": "#16141B",
            "image": "./assets/images/splash-icon-light.png"
          },
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "@react-native-community/datetimepicker",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Cho phép Event Ticketing lưu vé vào thư viện ảnh.",
          "granularPermissions": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
