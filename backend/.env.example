# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=*

# Database (matches docker-compose postgres service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/event_ticketing?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret-min-16-chars
JWT_EXPIRES_IN=1d
# Scanner-device tokens live longer; revocation is instant via BLOCKED status.
SCANNER_JWT_EXPIRES_IN=30d

# Ticket QR signing (HMAC-SHA256)
TICKET_HMAC_SECRET=replace-with-a-long-random-hmac-secret

# Orders
ORDER_HOLD_MINUTES=15

# Withdrawals (smallest payout an organizer may request)
WITHDRAWAL_MIN_AMOUNT_VND=100000

# SePay webhook (leave empty in dev)
SEPAY_WEBHOOK_API_KEY=
# SePay VietQR receiving account (bank short code + account number)
SEPAY_BANK=
SEPAY_ACCOUNT_NUMBER=

# Cloudinary image uploads (leave empty to disable uploads).
# Create a signed preset with max_file_size=5242880 and allowed_formats=jpg,png,webp.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Mail (SMTP; leave SMTP_HOST empty to disable email in dev).
# Values below are the Resend setup; SMTP_USER is always the literal "resend"
# and SMTP_PASS is the API key. Port 465 needs SMTP_SECURE=true, 587 needs false.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=eTicket <no-reply@eticket.khanhhuynh.id.vn>
